+
+def _atomic_write(path: Path, payload: str) -> None:
+    stream = NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent, delete=False)
+    staged = Path(stream.name)
+    try:
+        with stream:
+            stream.write(payload)
+        staged.replace(path)
