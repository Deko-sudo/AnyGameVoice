define mira = Character("Мира")
define lev = Character("Лев")
define config.name = "Ночной сигнал — учебная сцена"

label start:
    scene black
    "В комнате пахло пылью и тёплой электроникой."
    mira "Подожди. Ты тоже это слышишь?"
    lev "На этой частоте уже двадцать лет ничего нет."
    mira "Значит, кто-то решил нарушить тишину."
    "Мира повернула регулятор. Сквозь треск проступили три коротких сигнала."
    lev "Это не помехи. Кто-то повторяет координаты."
    mira "Записывай. Северная станция, сектор девять."
    lev "Станцию закрыли ещё до нашего рождения."
    mira "А передатчик работает. Интересно, откуда у него питание?"
    "За окном погас последний фонарь."
    menu:
        "Ответить на сигнал":
            jump answer
        "Продолжить слушать":
            jump listen
