{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnyGameVoice",
  "version": "0.1.0",
  "identifier": "com.anygamevoice.app",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:8000",
    "beforeDevCommand": "python app/main.py ui 8000",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "AnyGameVoice",
        "width": 1100,
        "height": 800,
        "url": "/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"],
    "category": "Utility"
  }
}
